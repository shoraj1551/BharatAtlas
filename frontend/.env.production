# Production Environment
# Used for live production deployment

# Mapbox Access Token (production token)
VITE_MAPBOX_TOKEN=your_production_mapbox_token_here

# Admin Mode (MUST be disabled in production)
VITE_ADMIN_MODE=false

# API Configuration
VITE_API_URL=https://api.bharatatlas.in/api
VITE_API_MODE=production

# Environment
VITE_ENV=production
