# Staging Environment
# Used for UAT and pre-production testing

# Mapbox Access Token (staging token)
VITE_MAPBOX_TOKEN=your_staging_mapbox_token_here

# Admin Mode (disabled in staging by default)
VITE_ADMIN_MODE=false

# API Configuration
VITE_API_URL=https://staging-api.bharatatlas.in/api
VITE_API_MODE=staging

# Environment
VITE_ENV=staging
