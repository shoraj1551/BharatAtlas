# Environment Variables Template
# Copy this file to .env.local for local development
# For staging: use .env.staging
# For production: use .env.production

# Mapbox Access Token (REQUIRED)
# Get your token from: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.eyJ1IjoiYmhhcmF0YXRsYXMiLCJhIjoiY21qcHBsd3NmMDg0YzNjcXh0YWJwNTZhaCJ9.hThXUyAFd1-XGbpzwr-T3w

# Admin Mode (default: false)
# Set to 'true' to enable admin features (curation, editing, verification)
# WARNING: MUST be 'false' in production
VITE_ADMIN_MODE=false

# API Configuration
# Local: http://localhost:3000/api
# Staging: https://staging-api.bharatatlas.in/api
# Production: https://api.bharatatlas.in/api
VITE_API_URL=http://localhost:3000/api

# API Mode (mock, staging, production)
VITE_API_MODE=mock

# Environment (local, staging, production)
VITE_ENV=local
